# ---- Browser Use Cloud ----
# Get one at https://cloud.browser-use.com  -> Settings -> API Keys
BROWSER_USE_API_KEY=bu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Concurrency ----
# Hard ceiling on simultaneously-held leases. Also clamped at runtime by the
# platform's own concurrentSessionLimit (read from /api/v2/billing/account).
CBMCP_MAX_CONCURRENCY=6
# One ceiling for every Claude window on this machine (all share the data dir).
CBMCP_SHARE_CONCURRENCY_ACROSS_GATEWAYS=true
# How long browser_acquire may block before returning a queue ticket.
# Keep it below your MCP client's tool-call timeout. Claude Code's is long
# (MCP_TOOL_TIMEOUT defaults to ~28 hours; a stdio server call is also cut off
# after 30 minutes with no response), but other MCP clients can be much
# shorter -- use 25 for those. A cloud browser can take up to ~50s to start.
CBMCP_ACQUIRE_BLOCK_SECONDS=60
# How long a queued ticket survives without being claimed.
CBMCP_QUEUE_TIMEOUT_SECONDS=600

# ---- Lease lifecycle (the three-layer reaper) ----
# Layer 1: no tool call on a lease for this long -> reclaimed.
CBMCP_IDLE_TIMEOUT_SECONDS=300
# Layer 2: absolute lease lifetime regardless of activity.
CBMCP_MAX_LEASE_SECONDS=1800
# Layer 3: platform-side hard stop, in minutes (1-240). Last line of defence:
# honoured even if this whole service dies. Keep it just above MAX_LEASE_SECONDS.
CBMCP_PLATFORM_TIMEOUT_MINUTES=35
CBMCP_REAPER_INTERVAL_SECONDS=15
# Orphan reconciliation against the platform's session list.
CBMCP_RECONCILE_INTERVAL_SECONDS=120
CBMCP_RECONCILE_ON_STARTUP=true
# Tag written into every session's metadata so reconciliation only ever stops
# sessions this deployment created. Change it per deployment, never share it.
CBMCP_OWNER_TAG=

# ---- Network egress ----
# direct | platform_proxy | custom_proxy
CBMCP_NETWORK_MODE=direct
CBMCP_PROXY_COUNTRY_CODE=us
# Only for network_mode=custom_proxy
CBMCP_CUSTOM_PROXY_HOST=
CBMCP_CUSTOM_PROXY_PORT=
CBMCP_CUSTOM_PROXY_USERNAME=
CBMCP_CUSTOM_PROXY_PASSWORD=
CBMCP_CUSTOM_PROXY_IGNORE_CERT_ERRORS=false

# ---- Budget ----
CBMCP_BUDGET_DAILY_USD=5.0
CBMCP_BUDGET_MONTHLY_USD=50.0
# Browser Use Cloud standalone browser time, as documented (2026-10): $0.02/hour.
CBMCP_PRICE_BROWSER_USD_PER_HOUR=0.02
# Rough proxy estimate used only for pre-flight reservation, settled from the API.
CBMCP_PRICE_PROXY_USD_PER_GB=8.0

# ---- Scope control (authorised-target enforcement) ----
# off | warn | enforce
CBMCP_SCOPE_MODE=enforce
# Comma-separated global allowlist. A lease may only narrow this, never widen it.
# Empty = no global restriction. Patterns: example.com, *.example.com
CBMCP_SCOPE_ALLOW=
CBMCP_SCOPE_DENY=

# ---- Output limits (these control LLM token cost, not just memory) ----
CBMCP_MAX_TEXT_CHARS=20000
CBMCP_MAX_SNAPSHOT_CHARS=40000
CBMCP_MAX_BODY_BYTES=2097152
CBMCP_MAX_NET_ENTRIES=2000
CBMCP_LEASE_DISK_QUOTA_BYTES=268435456
CBMCP_SCREENSHOT_FORMAT=jpeg
CBMCP_SCREENSHOT_QUALITY=70

# ---- Browser defaults ----
# Persistent profile used when browser_acquire names none: cookies, logins and
# local storage carry over between tasks. Empty = a clean browser every time.
# One browser per profile at a time; parallel acquires get a clean browser.
CBMCP_DEFAULT_PROFILE=
# Browser Use saves a profile some seconds after the browser stops; it stays
# locked this long so the next browser on it loads the saved state.
CBMCP_PROFILE_SAVE_SECONDS=25
CBMCP_SCREEN_WIDTH=1440
CBMCP_SCREEN_HEIGHT=900
CBMCP_SOLVE_CAPTCHAS=false
CBMCP_CAPTURE_BODIES=interesting
# How confirm()/prompt() dialogs are answered until page_dialog changes it.
# dismiss = Cancel (never confirms anything unasked) | accept = OK
CBMCP_DIALOG_DEFAULT=dismiss

# ---- Tool groups (trim the agent's tool list / context) ----
CBMCP_ENABLE_DEBUGGER_TOOLS=true
CBMCP_ENABLE_ADMIN_TOOLS=true

# ---- Storage / logging ----
# Default ~/.local/state/cbmcp ("~" is expanded).
CBMCP_DATA_DIR=
# page_upload only sends files from inside this directory.
# Default <data dir>/uploads.
CBMCP_UPLOAD_DIR=
# Local provider only: Chrome/Chromium executable or macOS .app bundle.
# CBMCP_CHROMIUM_PATH=/Applications/Google Chrome.app
CBMCP_LOG_LEVEL=INFO
